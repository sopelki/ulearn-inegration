<idea-plugin require-restart="true">
    <id>com.jetbrains.rider.plugins.ulearnintegration</id>
    <name>UlearnIntegration</name>
    <version>_PLACEHOLDER_</version>
    <vendor url="https://project-url">Author</vendor>
    <idea-version since-build="_PLACEHOLDER_" until-build="_PLACEHOLDER_"/>
    <depends>com.intellij.modules.rider</depends>

    <description>
        <![CDATA[
<p>Sample description</p>
]]>
    </description>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Ulearn"
                    anchor="left"
                    factoryClass="com.jetbrains.rider.plugins.ulearnintegration.UlearnToolWindowFactory"
                    icon="/icons/ulearn_u.svg"/>
        <notificationGroup id="Ulearn Notifications" displayType="BALLOON"/>
    </extensions>

</idea-plugin>
